<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rhythm Loop Pro - Phase 1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- ================= بخش ریتم ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥁 بخش ریتم"
                android:textColor="#FFCA28"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#2C2C2C"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Spinner
                    android:id="@+id/rhythmSpinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#2C2C2C" />

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:background="#333333"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSelectCustomRhythm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📁 My Own Rhythm (انتخاب فایل)"
                android:backgroundTint="#3700B3"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/txtCustomRhythm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#81C784"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnRhythmPlayStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶ پخش ریتم"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"/>

                <SeekBar
                    android:id="@+id/rhythmVolumeSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"/>

                <ToggleButton
                    android:id="@+id/rhythmMuteButton"
                    android:layout_width="65dp"
                    android:layout_height="36dp"
                    android:textOn="Mute"
                    android:textOff="Sound"
                    android:backgroundTint="#D32F2F"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= بخش هارمونی ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎸 بخش هارمونی"
                android:textColor="#FFCA28"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/harmonySpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#2C2C2C"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectCustomHarmony"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📁 My Own Harmony (انتخاب فایل)"
                android:backgroundTint="#3700B3"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/txtCustomHarmony"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#81C784"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnHarmonyPlayStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶ پخش هارمونی"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"/>

                <SeekBar
                    android:id="@+id/harmonyVolumeSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"/>

                <ToggleButton
                    android:id="@+id/harmonyMuteButton"
                    android:layout_width="65dp"
                    android:layout_height="36dp"
                    android:textOn="Mute"
                    android:textOff="Sound"
                    android:backgroundTint="#D32F2F"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= کنترل هم‌زمان و سرعت ================= -->
        <TextView
            android:id="@+id/bpmTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سرعت پخش: 1.0x"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/bpmSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnMasterPlay"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="▶ پخش هر دو"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnMasterStop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="⏹ توقف هر دو"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- علاقه‌مندی‌ها -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ لیست علاقه‌مندی‌ها:"
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
